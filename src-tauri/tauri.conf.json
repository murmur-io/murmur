{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur",
  "version": "2.5.0",
  "identifier": "com.meetnotes.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run start",
    "frontendDist": "../dist/meetnotes/browser",
    "beforeBuildCommand": "npm run build && cargo build -p murmur-brain --release --target aarch64-apple-darwin && cargo build -p murmur-brain --release --target x86_64-apple-darwin && lipo -create target/aarch64-apple-darwin/release/murmur-brain target/x86_64-apple-darwin/release/murmur-brain -output src-tauri/binaries/murmur-brain"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Murmur",
        "width": 1170,
        "height": 884,
        "visible": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 32,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; media-src 'self' asset:; object-src 'none'; frame-ancestors 'none'; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/Library/Application Support/MeetNotes/audio/*.wav",
            "$HOME/Library/Application Support/MeetNotes-dev/audio/*.wav"
          ],
          "deny": [
            "$HOME/Library/Application Support/MeetNotes/audio/**/*.enc",
            "$HOME/Library/Application Support/MeetNotes/audio/*.enc",
            "$HOME/Library/Application Support/MeetNotes/audio/**/*.encrypting",
            "$HOME/Library/Application Support/MeetNotes/audio/*.encrypting",
            "$HOME/Library/Application Support/MeetNotes-dev/audio/**/*.enc",
            "$HOME/Library/Application Support/MeetNotes-dev/audio/*.enc",
            "$HOME/Library/Application Support/MeetNotes-dev/audio/**/*.encrypting",
            "$HOME/Library/Application Support/MeetNotes-dev/audio/*.encrypting"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/meetnotes-sysaudio": "meetnotes-sysaudio",
      "binaries/meetnotes-audiocap": "meetnotes-audiocap",
      "binaries/meetnotes-aeccap": "meetnotes-aeccap",
      "binaries/meetnotes-calendar": "meetnotes-calendar",
      "binaries/murmur-brain": "murmur-brain"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4"
    }
  },
  "plugins": {}
}
