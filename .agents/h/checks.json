{
  "_comment": "Zmienione sciezki -> checki. Kolejnosc = kolejnosc uruchomienia (najtansze pierwsze).",
  "rust_test_scope_limit": 6,
  "checks": {
    "ng-lint": {
      "when": ["src/app/**", "src/*.ts", "eslint.config.js"],
      "cmd": "npx ng lint",
      "budget_s": 60
    },
    "ng-build": {
      "when": ["src/**", "angular.json", "tsconfig*.json"],
      "cmd": "npx ng build",
      "budget_s": 120
    },
    "rust-clippy": {
      "when": ["src-tauri/**/*.rs", "src-tauri/Cargo.toml", "crates/**/*.rs"],
      "cmd": "cargo clippy --lib --tests -- -D warnings",
      "cwd": "src-tauri",
      "budget_s": 600
    },
    "rust-test": {
      "when": ["src-tauri/**/*.rs", "src-tauri/Cargo.toml", "crates/**/*.rs"],
      "cmd": "cargo test --lib -- --test-threads=1",
      "cwd": "src-tauri",
      "scoped": true,
      "budget_s": 900
    },
    "tauri-boot": {
      "when": ["src-tauri/src/lib.rs", "src-tauri/src/state.rs", "src-tauri/src/audio/**", "src-tauri/src/transcribe/**", "src-tauri/tauri.conf.json", "src-tauri/**/*.swift"],
      "cmd": "scripts/harness-runtime-smoke",
      "budget_s": 600
    },
    "playwright": {
      "when": ["src/app/**", "e2e/**", "playwright.config.ts"],
      "cmd": "npm run test:e2e -- --workers=2",
      "scoped": true,
      "budget_s": 1200
    }
  },
  "manual_only": {
    "_comment": "Realne checki produktowe, ale w 74 uruchomieniach nie zlapaly nic. Odpalasz recznie: h check <id>.",
    "protocol-server": {
      "cmd": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/urc_dev cargo test --workspace -- --test-threads=1",
      "cwd": "src-tauri"
    },
    "perf-contracts": {
      "cmd": "bash .agents/h/perf-contracts.sh"
    }
  }
}
