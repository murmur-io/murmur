{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murmurnotes.io/schemas/development-commit-v1.json",
  "title": "Murmur attested task commit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "contract_sha256", "attestation_sha256",
    "commit_sha", "parent_sha", "tree_sha", "author", "committer",
    "message", "authored_at", "committed_at", "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attestation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "parent_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "author": { "$ref": "#/$defs/identity" },
    "committer": { "$ref": "#/$defs/identity" },
    "message": { "type": "string", "minLength": 1 },
    "authored_at": { "type": "string", "format": "date-time" },
    "committed_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 }
      }
    }
  }
}
