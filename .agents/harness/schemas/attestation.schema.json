{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murmurnotes.io/schemas/development-attestation-v2.json",
  "title": "Murmur final task attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "contract_sha256",
    "instructions_sha256",
    "dependency_revisions",
    "base_sha",
    "head_sha",
    "tree_sha",
    "staged_diff_sha256",
    "repo_realpath",
    "worktree_path",
    "risk_flags",
    "writer",
    "reviewer",
    "rounds",
    "checks",
    "reviews",
    "verdict",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "task_id": { "type": "string" },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instructions_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dependency_revisions": { "type": "object", "additionalProperties": { "type": "string" } },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "staged_diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repo_realpath": { "type": "string" },
    "worktree_path": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "writer": { "$ref": "#/$defs/writer" },
    "reviewer": { "$ref": "#/$defs/reviewerBase" },
    "rounds": { "type": "integer", "minimum": 1 },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } },
    "verdict": { "const": "PASS" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "reviewerBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "cli_version", "model"],
      "properties": {
        "vendor": { "enum": ["codex", "claude", "fake"] },
        "cli_version": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor", "cli_version", "model", "session_id", "round", "label",
        "result_path", "artifact_sha256", "invocation_path", "invocation_sha256",
        "log_path", "log_sha256", "created_at"
      ],
      "properties": {
        "vendor": { "enum": ["codex", "claude", "fake"] },
        "cli_version": { "type": "string" },
        "model": { "type": "string" },
        "session_id": { "type": "string" },
        "round": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "result_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "invocation_path": { "type": "string", "minLength": 1 },
        "invocation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "log_path": { "type": "string", "minLength": 1 },
        "log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "string", "format": "date-time" },
        "degraded": {
          "description": "How the writer round ended abnormally, or null on a clean round. RUNNER-derived, never taken from the model's self-report — a receipt for a killed writer must not be byte-shape-identical to a clean one.",
          "enum": ["timeout", "unparseable-report", null]
        },
        "timed_out": { "type": "boolean" },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "reviewerRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "cli_version", "model", "session_id"],
      "properties": {
        "vendor": { "enum": ["codex", "claude", "fake"] },
        "cli_version": { "type": "string" },
        "model": { "type": "string" },
        "session_id": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "command", "phase", "exit_code", "duration_ms", "log_sha256",
        "stdout_sha256", "stderr_sha256", "log_path", "sandbox_profile_path",
        "sandbox_profile_sha256", "sandbox_mode", "environment_keys_sha256", "environment_sha256", "playwright_port", "network_mode",
        "started_at", "created_at"
      ],
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string" },
        "phase": { "type": "string", "minLength": 1 },
        "exit_code": { "const": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "log_path": { "type": "string", "minLength": 1 },
        "sandbox_profile_path": { "type": "string", "minLength": 1 },
        "sandbox_profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sandbox_mode": { "enum": ["direct", "inherited"] },
        "environment_keys_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "environment_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "playwright_port": {
          "oneOf": [
            { "type": "integer", "minimum": 42000, "maximum": 61999 },
            { "type": "null" }
          ]
        },
        "network_mode": { "enum": ["none", "loopback"] },
        "started_at": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "verdict", "reviewer", "result_path", "artifact_sha256",
        "invocation_path", "invocation_sha256", "log_path", "log_sha256",
        "staged_diff_sha256", "created_at"
      ],
      "properties": {
        "kind": { "enum": ["spec", "adversarial", "lock-security", "egress-security", "protocol-security"] },
        "verdict": { "const": "PASS" },
        "reviewer": { "$ref": "#/$defs/reviewerRun" },
        "result_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "invocation_path": { "type": "string", "minLength": 1 },
        "invocation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "log_path": { "type": "string", "minLength": 1 },
        "log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "staged_diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
