{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MURMUR_AUTOFMT": "0"
  },
  "permissions": {
    "additionalDirectories": [
      "../.murmur-agent-tasks"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.codex/**)",
      "Read(~/.claude/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.npmrc)",
      "Read(~/Library/Keychains/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/Library/Application Support/MeetNotes/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "../.murmur-agent-tasks"
      ],
      "denyWrite": [
        "../meetnotes/.git",
        "../murmur-server/.git"
      ]
    },
    "network": {
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/h/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/autoformat.sh\""
          }
        ]
      }
    ]
  }
}
