/target
/node_modules
/dist
.DS_Store
# Local editor / tooling cruft — never tracked
.idea/
.playwright-mcp/
/settings-audio-controls.png
.claude/worktrees/
# Per-machine Claude override — audited by config_audit._local_settings, never committed
.claude/settings.local.json
.codex/worktrees/
.codex/tmp/
.codex/claude-settings.local.migrated.json
*.gguf
*.wav
*.mp4
# …except the published promo video. `*.mp4` above exists to keep stray captures
# and test recordings out of the repo; the landing page's own H.264 asset is a
# deliberate, reviewed artefact. Without this exception the <source> for it is
# committed as a 404 — the page keeps working in every browser that takes the
# VP9 alternate, and silently loses the video in the ones that do not.
!landing/assets/*.mp4
.angular
/src-tauri/target
# Build artifact: universal sidecar staged by build.rs for bundle.resources
/src-tauri/binaries/meetnotes-sysaudio
/src-tauri/binaries/meetnotes-audiocap
/src-tauri/binaries/meetnotes-aeccap
# Build artifact: universal brain sidecar staged by beforeBuildCommand for bundle.resources.
# Keep the old name ignored for one upgrade cycle; an existing local release artifact is generated.
/src-tauri/binaries/meetnotes-brain
/src-tauri/binaries/murmur-brain
.claude/tmp/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/
# E2E-generated screenshot artifacts (verification output, never committed)
e2e/**/__screens__/

# Stray dev database must never be committed (PII-bearing SQLite)
meetnotes.db
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Loadout run artifacts (inne narzedzie, nie nalezy do repo)
.loadout/

# Promo-video intermediates (scripts/promo) — large and rebuildable.
.promo/
