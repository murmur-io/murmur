#!/usr/bin/env python3
"""Mirror the canonical .claude/learnings tree into the generated .codex/learnings tree.

`.claude/learnings/` is the single source of truth: it is what `/learn`, `/curate-learnings`,
the `murmur-learn` / `murmur-curate-learnings` skills, and any extractor pass write.
`.codex/learnings/` is a byte-identical generated copy, so a hand-edit there is destroyed by the
next sync and `scripts/agent-config-audit` fails on the drift in the meantime.

Bytes only, never text mode: the journals carry em-dashes, `ń`, `ɵcmp`, `≤` and `→`, and an
encoding-dependent round-trip would trip the very parity check this script exists to satisfy.
"""

import argparse
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
CANONICAL = ROOT / ".claude" / "learnings"
MIRROR = ROOT / ".codex" / "learnings"


def _read_tree(directory):
    """Map `*.md` filename -> bytes for one learnings tree (sorted for determinism)."""

    return {path.name: path.read_bytes() for path in sorted(directory.glob("*.md"))}


def main(argv):
    parser = argparse.ArgumentParser(description="Sync .claude/learnings -> .codex/learnings.")
    parser.add_argument("--check", action="store_true", help="report drift, write nothing")
    args = parser.parse_args(argv)

    if not CANONICAL.is_dir():
        print(f"missing canonical learnings tree: {CANONICAL}", file=sys.stderr)
        return 1

    canonical = _read_tree(CANONICAL)
    if not canonical:
        print(f"canonical learnings tree is empty: {CANONICAL}", file=sys.stderr)
        return 1
    mirror = _read_tree(MIRROR) if MIRROR.is_dir() else {}

    stale = [name for name in sorted(canonical) if mirror.get(name) != canonical[name]]
    extra = [name for name in sorted(mirror) if name not in canonical]

    if args.check:
        for name in stale:
            print(f"learnings drift: .codex/learnings/{name} differs from canonical", file=sys.stderr)
        for name in extra:
            print(f"learnings drift: .codex/learnings/{name} has no canonical source", file=sys.stderr)
        if stale or extra:
            print(f"{len(stale) + len(extra)} file(s) out of sync — run scripts/agent-sync-learnings", file=sys.stderr)
            return 1
        print(f"learnings mirror in sync ({len(canonical)} files)")
        return 0

    MIRROR.mkdir(parents=True, exist_ok=True)
    for name in stale:
        (MIRROR / name).write_bytes(canonical[name])
    for name in extra:
        (MIRROR / name).unlink()
    print(f"learnings mirror synced ({len(canonical)} files, {len(stale)} written, {len(extra)} removed)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
