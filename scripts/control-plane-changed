#!/usr/bin/env bash
# Decide whether THIS working tree changes the development control plane.
#
#   exit 0  → run the control-plane checks (they changed, OR the answer could
#             not be determined and the safe answer is "run everything")
#   exit 1  → this is a product-only diff; the expensive control-plane
#             selftests cannot observe anything new
#
# WHY. `scripts/ci.sh` re-verifies the control plane on every diff. Measured on
# this machine 2026-08-01: `agent-harness selftest --ci` 54 s,
# `verify-harness-attestation --selftest` 4.6 s, `.codex/hooks/selftest.sh` 21 s,
# `agent-remote-audit --selftest` 0.33 s, `agent-config-audit --ci` 0.09 s. A
# one-line Angular change pays the whole bill, twice (local ci.sh, then Actions
# re-running ci.sh).
#
# WHAT IT MUST NOT DO. The audit (`agent-config-audit --ci`) is NEVER gated —
# CLAUDE.md states, with PR #535 behind it, that it is the cheapest check in the
# repo and the only one that sees `.claude/`↔`.codex/` binding drift and a
# silently disabled Bash hook. Deciding whether a diff "touches the control
# plane" costs more thought than that check costs time. The eval steps are never
# gated either: 5 s, and they guard the instrument.
#
# FAIL SAFE, ALWAYS. Every path out of this script that is not a confident
# "product-only" answer exits 0. No git, not a work tree, a shallow clone, a
# detached HEAD, an unresolvable base ref, no merge base, any git error at all:
# run everything. A guard that silently skips on error is worse than no guard,
# so the error branches are proven by `--selftest` and that selftest runs
# UNCONDITIONALLY in ci.sh — a broken guard cannot suppress its own proof.
#
# Usage:  scripts/control-plane-changed [--quiet]
#         scripts/control-plane-changed --selftest
set -euo pipefail

# Any path under these prefixes, or any of these exact files, is control plane.
CONTROL_PLANE_PREFIXES=(
  ".agents/"
  ".claude/"
  ".codex/"
  "scripts/"
  "eval/agents/"
)
CONTROL_PLANE_FILES=(
  "CLAUDE.md"
  "AGENTS.md"
)

QUIET=0
SELFTEST=0
for argument in "$@"; do
  case "$argument" in
    --quiet) QUIET=1 ;;
    --selftest) SELFTEST=1 ;;
    *) echo "usage: scripts/control-plane-changed [--quiet|--selftest]" >&2; exit 2 ;;
  esac
done

say() {
  [ "$QUIET" = "1" ] || echo "control-plane-changed: $1" >&2
}

# Exit 0 with the reason recorded. Used for every indeterminate case.
run_everything() {
  say "$1 — running the control-plane checks"
  exit 0
}

path_is_control_plane() {
  local candidate="$1" prefix file
  for prefix in "${CONTROL_PLANE_PREFIXES[@]}"; do
    case "$candidate" in "$prefix"*) return 0 ;; esac
  done
  for file in "${CONTROL_PLANE_FILES[@]}"; do
    [ "$candidate" = "$file" ] && return 0
  done
  return 1
}

decide() {
  local base_ref base_sha merge_base head_ref changed path

  command -v git >/dev/null 2>&1 || run_everything "git is not on PATH"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || run_everything "not inside a git work tree"

  # A shallow clone has no usable history to diff against. GitHub Actions checks
  # this repo out at the default fetch-depth 1 on a synthetic merge commit, so
  # this branch is the one CI actually takes: the guard buys local time and
  # deliberately buys nothing remotely rather than guessing.
  if [ "$(git rev-parse --is-shallow-repository 2>/dev/null || echo unknown)" != "false" ]; then
    run_everything "shallow or unknown clone depth"
  fi

  # No branch identity means no reliable statement about "the change".
  head_ref="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [ -n "$head_ref" ] || run_everything "detached HEAD"

  base_ref="${MURMUR_CI_CONTROL_PLANE_BASE:-}"
  if [ -z "$base_ref" ]; then
    base_ref="$(python3 -c 'import json,pathlib,sys
try:
    document = json.loads(pathlib.Path(".agents/harness/config.json").read_text(encoding="utf-8"))
    value = document.get("default_base")
    sys.stdout.write(value if isinstance(value, str) and value else "")
except Exception:
    pass' 2>/dev/null || true)"
  fi
  # `.agents/harness/config.json` may omit `default_base`; the harness itself
  # falls back to origin/murmur (see `default_base` handling in cli.py), so the
  # guard must resolve to the same trunk instead of guessing.
  [ -n "$base_ref" ] || base_ref="origin/murmur"

  base_sha="$(git rev-parse --verify --quiet "${base_ref}^{commit}" 2>/dev/null || true)"
  [ -n "$base_sha" ] || run_everything "base ref ${base_ref} does not resolve"

  merge_base="$(git merge-base HEAD "$base_sha" 2>/dev/null || true)"
  [ -n "$merge_base" ] || run_everything "no merge base with ${base_ref}"

  # Committed + unstaged changes against the merge base, plus untracked files.
  # `git diff <commit>` already compares the WORKING TREE, so unstaged edits are
  # covered; untracked files are not, and a brand-new control-plane file is
  # exactly the case that must not slip through.
  if ! changed="$(
    {
      git diff --name-only -z "$merge_base" -- 2>/dev/null || exit 1
      git ls-files --others --exclude-standard -z 2>/dev/null || exit 1
    } | tr '\0' '\n'
  )"; then
    run_everything "git could not list the changed paths"
  fi

  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if path_is_control_plane "$path"; then
      say "control-plane path changed: $path"
      exit 0
    fi
  done <<EOF
$changed
EOF

  say "product-only diff against ${base_ref} — skipping the expensive control-plane checks"
  exit 1
}

# ── Selftest ────────────────────────────────────────────────────────────────
# Proves the two answers AND every fail-safe branch. Cheap (temporary repos, no
# network, no build), so ci.sh runs it unconditionally.
selftest() {
  local script failures=0 total=0
  # The fixtures declare their own base ref. An override inherited from the
  # caller (ci.sh runs the selftest in whatever environment CI supplies) would
  # otherwise point every fixture at a ref it does not have, which fails safe
  # and silently turns the two "skip" assertions vacuous.
  unset MURMUR_CI_CONTROL_PLANE_BASE
  script="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  # Deliberately global: the EXIT trap below runs after this function returns.
  SELFTEST_TMP="$(mktemp -d "${TMPDIR:-/tmp}/control-plane-guard.XXXXXX")"
  local tmp="$SELFTEST_TMP"
  trap 'rm -rf "$SELFTEST_TMP"' EXIT

  expect() {
    local label="$1" wanted="$2"
    shift 2
    local actual=0
    "$@" >/dev/null 2>&1 || actual=$?
    total=$((total + 1))
    if [ "$actual" = "$wanted" ]; then
      echo "  [PASS] $label"
    else
      echo "  [FAIL] $label (wanted exit $wanted, got $actual)"
      failures=$((failures + 1))
    fi
  }

  make_repo() {
    local root="$1"
    mkdir -p "$root"
    git -C "$root" init --quiet --initial-branch=murmur
    git -C "$root" config user.name "Selftest"
    git -C "$root" config user.email "selftest@example.invalid"
    mkdir -p "$root/.agents/harness" "$root/src/app" "$root/scripts"
    printf '{"default_base": "murmur-base"}\n' \
      > "$root/.agents/harness/config.json"
    printf 'product\n' > "$root/src/app/app.ts"
    git -C "$root" add -A
    git -C "$root" commit --quiet -m "base"
    git -C "$root" branch murmur-base
    git -C "$root" checkout --quiet -b work
  }

  run_in() { ( cd "$1" && shift && "$@" ); }

  # 1. A product-only committed change is skippable.
  make_repo "$tmp/product"
  printf 'product changed\n' > "$tmp/product/src/app/app.ts"
  git -C "$tmp/product" commit --quiet -am "product"
  expect "product-only committed diff skips" 1 \
    run_in "$tmp/product" "$script" --quiet

  # 2. An unstaged product edit is still skippable.
  printf 'product changed again\n' > "$tmp/product/src/app/app.ts"
  expect "product-only unstaged diff skips" 1 \
    run_in "$tmp/product" "$script" --quiet

  # 3. A committed control-plane change runs everything.
  make_repo "$tmp/harness"
  printf '{"default_base": "murmur-base", "x": 1}\n' \
    > "$tmp/harness/.agents/harness/config.json"
  git -C "$tmp/harness" commit --quiet -am "control plane"
  expect "changed .agents path runs everything" 0 \
    run_in "$tmp/harness" "$script" --quiet

  # 4. An UNTRACKED control-plane file runs everything. `git diff` alone cannot
  #    see this, which is why the guard also reads `git ls-files --others`.
  make_repo "$tmp/untracked"
  mkdir -p "$tmp/untracked/.claude"
  printf 'new hook\n' > "$tmp/untracked/.claude/hook.sh"
  expect "untracked control-plane file runs everything" 0 \
    run_in "$tmp/untracked" "$script" --quiet

  # 5. CLAUDE.md is control plane even though it is not under a prefix.
  make_repo "$tmp/claudemd"
  printf 'rules\n' > "$tmp/claudemd/CLAUDE.md"
  expect "CLAUDE.md runs everything" 0 \
    run_in "$tmp/claudemd" "$script" --quiet

  # 6. FAIL SAFE — the configured base ref does not exist.
  make_repo "$tmp/nobase"
  printf 'product changed\n' > "$tmp/nobase/src/app/app.ts"
  git -C "$tmp/nobase" commit --quiet -am "product"
  git -C "$tmp/nobase" branch -D murmur-base >/dev/null 2>&1
  expect "missing base ref runs everything" 0 \
    run_in "$tmp/nobase" "$script" --quiet

  # 7. FAIL SAFE — a shallow clone (what GitHub Actions actually checks out).
  make_repo "$tmp/deep"
  printf 'product changed\n' > "$tmp/deep/src/app/app.ts"
  git -C "$tmp/deep" commit --quiet -am "product"
  git clone --quiet --depth 1 --branch work \
    "file://$tmp/deep" "$tmp/shallow" >/dev/null 2>&1
  # Give the shallow clone a base ref that DOES resolve, so the shallow branch
  # is the only thing standing between this fixture and a wrong "skip": with a
  # depth-1 history the merge base is HEAD itself and the diff looks empty.
  git -C "$tmp/shallow" branch murmur-base HEAD >/dev/null 2>&1
  expect "shallow clone runs everything" 0 \
    run_in "$tmp/shallow" "$script" --quiet

  # 8. FAIL SAFE — detached HEAD.
  make_repo "$tmp/detached"
  printf 'product changed\n' > "$tmp/detached/src/app/app.ts"
  git -C "$tmp/detached" commit --quiet -am "product"
  git -C "$tmp/detached" checkout --quiet --detach HEAD
  expect "detached HEAD runs everything" 0 \
    run_in "$tmp/detached" "$script" --quiet

  # 9. FAIL SAFE — not a git work tree at all.
  mkdir -p "$tmp/plain"
  expect "non-repository runs everything" 0 \
    run_in "$tmp/plain" "$script" --quiet

  # 10. FAIL SAFE — git missing from PATH entirely. `bash` is invoked by
  #     absolute path precisely because PATH is emptied for the child.
  mkdir -p "$tmp/emptybin"
  without_git() { PATH="$tmp/emptybin" /bin/bash "$script" --quiet; }
  expect "git absent from PATH runs everything" 0 without_git

  # 11. An explicit base override is honoured (and still fails safe when bogus).
  bogus_base() {
    ( cd "$tmp/product" \
      && MURMUR_CI_CONTROL_PLANE_BASE=refs/heads/does-not-exist \
         "$script" --quiet )
  }
  expect "bogus base override runs everything" 0 bogus_base

  echo "control-plane guard selftest: $((total - failures))/$total assertions passed"
  [ "$failures" = "0" ] || return 1
  return 0
}

if [ "$SELFTEST" = "1" ]; then
  selftest
  exit $?
fi

decide
