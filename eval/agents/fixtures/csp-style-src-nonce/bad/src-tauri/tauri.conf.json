{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur",
  "version": "1.1.0",
  "identifier": "com.meetnotes.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/murmur/browser"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Murmur",
        "width": 900,
        "height": 680,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; media-src 'self' asset:; object-src 'none'; frame-ancestors 'none'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/Library/Application Support/Murmur/audio/*.wav"
          ],
          "deny": [
            "$HOME/Library/Application Support/Murmur/audio/*.enc"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.4"
    }
  },
  "plugins": {}
}
